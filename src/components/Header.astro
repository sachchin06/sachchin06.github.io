---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  name: string;
}

const { name } = Astro.props;

const links = [
  { href: '/#about', label: 'About' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">{name}</a>

    <div class="controls">
      <nav aria-label="Main">
        <button
          class="menu-button"
          type="button"
          aria-expanded="false"
          aria-controls="nav-links"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path class="icon-open" d="M4 7h16M4 12h16M4 17h16"></path>
            <path class="icon-close" d="M6 6l12 12M18 6L6 18"></path>
          </svg>
          <span>Menu</span>
        </button>
        <ul id="nav-links" class="nav-links">
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: 1px solid var(--border);
  }

  @supports (backdrop-filter: blur(8px)) {
    .site-header {
      backdrop-filter: blur(8px);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: var(--header-h);
  }

  .brand {
    color: var(--text);
    font-weight: 650;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    line-height: 1.25;
    padding-block: 0.4rem;
  }

  .brand:hover {
    color: var(--accent);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.25rem;
  }

  .nav-links a {
    display: block;
    padding: 0.5rem 0.65rem;
    border-radius: var(--radius);
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--text);
    background: var(--surface);
  }

  .menu-button {
    display: none;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
  }

  .menu-button svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .icon-close {
    display: none;
  }

  .menu-button[aria-expanded='true'] .icon-open {
    display: none;
  }

  .menu-button[aria-expanded='true'] .icon-close {
    display: inline;
  }

  /* Mobile: collapse the links behind the menu button (only when JS runs,
     so the links stay reachable without it). */
  @media (max-width: 47.99rem) {
    :global(html.js) .menu-button {
      display: inline-flex;
    }

    :global(html.js) .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem var(--gutter) 1rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    :global(html.js) .nav-links.open {
      display: flex;
    }

    :global(html.js) .nav-links a {
      padding: 0.75rem 0.5rem;
      font-size: 1rem;
    }

    :global(html:not(.js)) .bar {
      flex-wrap: wrap;
    }

    :global(html:not(.js)) .nav-links {
      flex-wrap: wrap;
    }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const list = document.getElementById('nav-links');

  if (button && list) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      list.classList.toggle('open', open);
    };

    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });

    // Close after choosing a link.
    list.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    // Close on Escape and return focus to the button.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });

    // Close when focus or a click moves outside the header.
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.site-header')) setOpen(false);
    });

    // Reset when resizing up to the desktop layout.
    window.matchMedia('(min-width: 48rem)').addEventListener('change', () => setOpen(false));
  }
</script>
