---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import Gallery from '../../components/Gallery.astro';
import Icon from '../../components/Icon.astro';
import { getSingle, showClient } from '../../lib/content';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, company, employment, client, role, period, summary, tags, status, links, screenshots } = project.data;
const { Content } = await render(project);
const about = await getSingle('about');

// Hide lines that are empty or only repeat the company (e.g. personal projects).
const facts = [
  { label: 'Company', value: company },
  { label: 'Client', value: client, show: showClient(client) && client !== company },
  { label: 'Employment', value: employment, show: employment !== company },
  { label: 'Role', value: role },
  { label: 'Period', value: period, show: period.trim() !== '' },
  { label: 'Status', value: status },
].filter((f) => f.show !== false);
---

<BaseLayout title={`${title} | ${about.data.name}`} description={summary} type="article">
  <article class="container project">
    <p class="back">
      <a href="/#projects">
        <Icon name="arrow-left" />
        All projects
      </a>
    </p>

    <header class="head">
      <h1>{title}</h1>
      <p class="summary">{summary}</p>

      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <TagList tags={tags} label="Technologies used" size="md" />

      {
        (links.live || links.repo) && (
          <p class="links">
            {links.live && (
              <a class="btn" href={links.live}>
                <Icon name="external" />
                Live site
              </a>
            )}
            {links.repo && (
              <a class="btn" href={links.repo}>
                <Icon name="code" />
                Source code
              </a>
            )}
          </p>
        )
      }
    </header>

    <div class="prose body">
      <Content />
    </div>

    <Gallery screenshots={screenshots} />

    <p class="back bottom">
      <a href="/#projects">
        <Icon name="arrow-left" />
        All projects
      </a>
    </p>
  </article>
</BaseLayout>

<style>
  .project {
    padding-block: 2rem 4rem;
  }

  .back a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-weight: 500;
  }

  .back :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .back.bottom {
    margin-top: 3rem;
  }

  .head {
    max-width: 48rem;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.4rem);
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
  }

  .summary {
    font-size: 1.1rem;
    color: var(--muted);
    margin-bottom: 1.75rem;
  }

  .facts {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .facts div {
    display: grid;
    gap: 0.1rem;
  }

  @media (min-width: 40rem) {
    .facts div {
      grid-template-columns: 7.5rem 1fr;
      gap: 1rem;
    }
  }

  dt {
    color: var(--muted);
    font-size: 0.9rem;
    padding-top: 0.05rem;
  }

  dd {
    margin: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
  }
</style>
