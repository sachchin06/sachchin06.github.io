---
import { render } from 'astro:content';
import Icon from './Icon.astro';
import { getSingle, toTelHref } from '../lib/content';

const contact = await getSingle('contact');
const { email, phone, linkedin, github, location } = contact.data;
const { Content } = await render(contact);

// Display "linkedin.com/in/..." rather than the full URL.
const shortUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container reveal">
    <h2 id="contact-title" class="section-title">Contact</h2>
    <div class="intro prose">
      <Content />
    </div>

    <ul class="list">
      <li>
        <Icon name="mail" />
        <span class="label">Email</span>
        <a href={`mailto:${email}`}>{email}</a>
      </li>
      <li>
        <Icon name="phone" />
        <span class="label">Phone</span>
        <a href={toTelHref(phone)}>{phone}</a>
      </li>
      <li>
        <Icon name="linkedin" />
        <span class="label">LinkedIn</span>
        <a href={linkedin}>{shortUrl(linkedin)}</a>
      </li>
      <li>
        <Icon name="github" />
        <span class="label">GitHub</span>
        <a href={github}>{shortUrl(github)}</a>
      </li>
      <li>
        <Icon name="pin" />
        <span class="label">Location</span>
        <span>{location}</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .intro {
    margin-bottom: 1.5rem;
  }

  .intro :global(p) {
    font-size: 1.05rem;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
    max-width: 36rem;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    min-height: 2.75rem;
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--border);
  }

  .label {
    min-width: 5rem;
  }

  li :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--muted);
  }

  .label {
    color: var(--muted);
    font-size: 0.9rem;
  }

  li a {
    font-weight: 500;
    word-break: break-word;
  }
</style>
