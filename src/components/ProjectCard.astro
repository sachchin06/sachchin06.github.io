---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import TagList from './TagList.astro';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, company, summary, tags, links, cover, coverAlt } = project.data;
const href = `/projects/${project.id}/`;
const titleId = `project-${project.id}`;
---

<article class="card" aria-labelledby={titleId}>
  {
    cover && (
      <Picture
        class="cover"
        src={cover}
        alt={coverAlt ?? ''}
        formats={['avif', 'webp']}
        widths={[400, 640, 800]}
        sizes="(min-width: 68rem) 21rem, (min-width: 48rem) 45vw, 100vw"
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="body">
    <h3 id={titleId}>
      <a href={href}>{title}</a>
    </h3>
    <p class="company">{company}</p>
    <p class="summary">{summary}</p>
    <TagList tags={tags} label={`Technologies used in ${title}`} />
    <ul class="links">
      <li>
        <a href={href} aria-label={`Read more about ${title}`}>Read more</a>
      </li>
      {
        links.live && (
          <li>
            <a href={links.live} aria-label={`Live site for ${title}`}>
              <Icon name="external" />
              Live site
            </a>
          </li>
        )
      }
      {
        links.repo && (
          <li>
            <a href={links.repo} aria-label={`Source code for ${title}`}>
              <Icon name="code" />
              Source code
            </a>
          </li>
        )
      }
    </ul>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .card:hover {
    border-color: var(--border-strong);
    box-shadow: 0 4px 16px -8px rgb(15 23 42 / 0.15);
  }

  .card :global(.cover) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
    padding: 1.25rem;
  }

  h3 {
    font-size: 1.05rem;
    margin: 0;
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .company {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
    font-weight: 500;
  }

  .summary {
    margin: 0 0 0.25rem;
    font-size: 0.95rem;
  }

  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: auto 0 0;
    padding: 0.75rem 0 0;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2rem;
  }

  .links :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }
</style>
